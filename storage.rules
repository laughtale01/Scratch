rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    // Firestore の users 文書を読む（Storage のルールからは firestore.get を使う）
    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    function isTeacher() {
      return isAuthenticated() && getUserData().role == 'teacher';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 講師が受け持つ教室か確認（教室IDが未設定の講師はどの教室も受け持たない）
    function isTeacherOfClassroom(classroomId) {
      let myClassroomId = getUserData().classroomId;
      return isTeacher() && myClassroomId is string && classroomId == myClassroomId;
    }

    // 作品のファイルを見てよいか確認
    // （管理者か、作品の持ち主がこの場所の持ち主と同じで、その作品の教室の講師）
    // 講師・管理者が作る作品は教室が null なので、講師に見えるのは自教室の生徒の作品だけ
    function canAccessProject(ownerUid, projectId) {
      let project = firestore.get(/databases/(default)/documents/projects/$(projectId));
      return isAdmin() || (
        project != null &&
        project.data.userId == ownerUid &&
        isTeacherOfClassroom(project.data.classroomId)
      );
    }

    // サムネイルを見てよいか確認（fileName は "{作品ID}.png"。作品のファイルと同じく作品の文書で判定する）
    function canAccessThumbnail(ownerUid, fileName) {
      return fileName.matches('[A-Za-z0-9]{1,128}[.]png') &&
        canAccessProject(ownerUid, fileName.split('[.]')[0]);
    }

    // Scratchプロジェクト本体・履歴
    // - 読み取り・削除: 持ち主、管理者、その作品の教室の講師
    // - 作成・上書き: 持ち主のみ（講師がファイルを書き換えることはない）
    match /projects/{ownerUid}/{projectId}/{allPaths=**} {
      allow read, delete: if isOwner(ownerUid) || canAccessProject(ownerUid, projectId);
      allow create, update: if isOwner(ownerUid);
    }

    // サムネイル
    match /thumbnails/{ownerUid}/{fileName} {
      // fileNameは "{projectId}.png" 形式
      allow read, delete: if isOwner(ownerUid) || canAccessThumbnail(ownerUid, fileName);
      allow create, update: if isOwner(ownerUid);
    }

    // 録画（インターネットには公開しない。講師・管理者には Cloud Functions が 15 分の署名付き URL を渡す）
    // - 置くのは Cloud Functions の署名付き URL だけ。SDK から直接は置けない
    //   （SDK で置くと期限のないダウンロード用トークンが付き、誰でも見られてしまうため）
    // - 読み取り: SDK からは誰も読めない（読むと期限のないトークンが作られるため。管理者も署名付き URL で見る）
    // - 削除: 持ち主、管理者
    match /recordings/{ownerUid}/{fileName} {
      allow read: if false;
      allow delete: if isOwner(ownerUid) || isAdmin();
      allow create, update: if false;
    }

    // それ以外は拒否
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
